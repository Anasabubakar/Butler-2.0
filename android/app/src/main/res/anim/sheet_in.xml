<?xml version="1.0" encoding="utf-8"?>
<!-- B2 · 07 "listen": fades in, grows from 95% and drops into place in 160 ms. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="160"
    android:interpolator="@interpolator/b2_enter">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale
        android:fromXScale="0.95" android:toXScale="1"
        android:fromYScale="0.95" android:toYScale="1"
        android:pivotX="50%" android:pivotY="0%" />
    <translate android:fromYDelta="-8dp" android:toYDelta="0" />
</set>
