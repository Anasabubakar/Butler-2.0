<?xml version="1.0" encoding="utf-8"?>
<!-- B2 · 07 "dismiss": the reverse of sheet_in, tucked away with the exit easing. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220"
    android:interpolator="@interpolator/b2_exit">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <scale
        android:fromXScale="1" android:toXScale="0.95"
        android:fromYScale="1" android:toYScale="0.95"
        android:pivotX="50%" android:pivotY="0%" />
</set>
