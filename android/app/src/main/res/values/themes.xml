<resources>
    <!-- Butler 2.0 on light: paper page, white surfaces, ink text and ink controls (B2 · 06).
         Dark mode is in values-night. Vermilion stays a small accent, never a whole button. -->
    <style name="Theme.Butler" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/b2_ink</item>
        <item name="colorOnPrimary">@color/b2_white</item>
        <item name="colorPrimaryContainer">@color/b2_paper</item>
        <item name="colorOnPrimaryContainer">@color/b2_ink</item>
        <item name="colorSecondary">@color/b2_ink</item>
        <item name="colorOnSecondary">@color/b2_white</item>
        <item name="colorSecondaryContainer">@color/b2_line</item>
        <item name="colorOnSecondaryContainer">@color/b2_ink</item>
        <item name="colorTertiary">@color/b2_vermilion</item>
        <item name="android:colorBackground">@color/b2_paper</item>
        <item name="colorSurface">@color/b2_white</item>
        <item name="colorOnSurface">@color/b2_ink</item>
        <item name="colorOnSurfaceVariant">@color/b2_muted</item>
        <item name="colorOutline">@color/b2_line</item>
        <item name="colorError">@color/b2_action_red</item>
        <item name="android:statusBarColor">@color/b2_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Small dark sheet over whatever app you're in: ink and charcoal, like the pet's bubble. -->
    <style name="Theme.Butler.Sheet" parent="Theme.Material3.Dark.Dialog">
        <item name="colorPrimary">@color/b2_white</item>
        <item name="colorOnPrimary">@color/b2_ink</item>
        <item name="colorSecondaryContainer">#262523</item>
        <item name="colorOnSecondaryContainer">@color/b2_white</item>
        <item name="colorTertiary">@color/b2_vermilion</item>
        <item name="colorSurface">@color/b2_ink</item>
        <item name="colorOnSurface">@color/b2_white</item>
        <item name="colorOnSurfaceVariant">@color/b2_dark_muted</item>
        <item name="colorOutline">@color/b2_dark_line</item>
        <item name="colorError">@color/b2_dark_failed</item>
        <item name="android:textColorPrimary">@color/b2_white</item>
        <item name="android:textColorSecondary">@color/b2_dark_muted</item>
        <item name="android:textColorHint">#8A8680</item>
        <item name="android:windowBackground">@drawable/sheet_background</item>
        <item name="android:windowAnimationStyle">@style/Butler.SheetAnimation</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Butler.SheetAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>
