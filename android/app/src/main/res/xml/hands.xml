<?xml version="1.0" encoding="utf-8"?>
<!-- Butler's Accessibility helper: sees the screen and taps only when you press a pet button.
     It also notices taps on Copy, for clipboard sync when you turn that on. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewClicked|typeAnnouncement|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/hands_description"
    android:notificationTimeout="100" />
