# Secret settings for the Butler server. Keep this file off GitHub.

# Devices send this in the x-butler-token header. Make it with: openssl rand -hex 32
BUTLER_TOKEN=

# Website password, hashed. Make it with: docker compose run --rm butler run server/hash-password.ts
BUTLER_PASSWORD_HASH=

# Signs the login cookie. Make it with: openssl rand -hex 32
SESSION_SECRET=

# Organizes saved items, with either a local model or Claude.
# Local (free, slower): set BUTLER_AI=local here and COMPOSE_PROFILES=local-ai in .env.
# BUTLER_AI=local
# BUTLER_LOCAL_MODEL=gemma3:4b
# Claude (paid, better and faster):
ANTHROPIC_API_KEY=
# Optional: claude-haiku-5-5 is much cheaper than the default claude-opus-5-5.
# BUTLER_MODEL=claude-haiku-5-5

# Gemini lets the desktop pet see the screen (find Share, Analyze, Solve) and
# organizes screenshot saves when BUTLER_AI=local. Get a key at aistudio.google.com.
GEMINI_API_KEY=
# Optional: pick a model; Butler falls back to others if it's retired.
# BUTLER_GEMINI_MODEL=gemini-flash-latest
